{
  "name": "@ray-js/smart-ui-lynx",
  "version": "0.1.0-beta.0",
  "description": "Ray component wrappers for Tuya Lynx native MiniApp pages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tuya-Community/ray-smart-ui.git",
    "directory": "lynx"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "files": [
    "lib",
    "es"
  ],
  "scripts": {
    "build": "node tools/build.cjs && node tools/verify-package.cjs",
    "prepack": "npm run build",
    "verify:package": "node tools/verify-package.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test render-mode.test.cjs"
  },
  "dependencies": {
    "@tuya/miniapp-smart-ui-lynx": "0.1.0-beta.0",
    "@ray-js/components-ty-slider": "^0.3.9",
    "lodash-es": "^4.17.21",
    "miniprogram-api-typings": "^5.2.3"
  },
  "peerDependencies": {
    "@ray-js/smart-ui": ">=2.13.3 <3",
    "react": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "@ray-js/smart-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ray-js/smart-ui": "2.13.7",
    "@types/lodash-es": "4.17.12",
    "@types/node": "16.18.126",
    "@types/react": "17.0.91",
    "@types/react-dom": "17.0.26",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "typescript": "4.9.5"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./native": {
      "types": "./es/native.d.ts",
      "import": "./es/native.js",
      "require": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "native": [
        "es/native.d.ts"
      ]
    }
  }
}
